# Copy to ".env" and adjust — never commit ".env".

# Database (SQLAlchemy URL)
# Default if unset: SQLite at ./data/voice_ver_sign.db
# DATABASE_URL=sqlite:///./data/voice_ver_sign.db
# Production (PostgreSQL example):
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/voice_ver_sign
# MySQL 8.0 (install pymysql; create DB in Workbench / XAMPP):
# DATABASE_URL=mysql+pymysql://root:@127.0.0.1:3306/voice_ver_sign

# JWT signing secret — REQUIRED in production (generate a long random string)
# VVS_SECRET=change-me-in-production

# Optional: seed one admin user on first startup (not exposed in public signup)
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=change-me-strong-password
# ADMIN_NAME=Administrator

# Comma-separated browser origins allowed by CORS (not * in production)
# CORS_ORIGINS=https://yourdomain.com

# HTTP bind (used by app.py)
# HOST=0.0.0.0
# PORT=5000

# Dev server: auto-reload only watches server/ + public/ (not .venv). Set false to disable reload.
# UVICORN_RELOAD=false
